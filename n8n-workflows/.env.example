# RemitBuddy Blog Automation - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED
# ===========================================

# Anthropic Claude API Key
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Notion Integration Token
# Create at: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your-token-here

# Notion Database IDs (Korean)
# Find in database URL: notion.so/workspace/DATABASE_ID?v=...
NOTION_DB_KO=your-korean-database-id

# Notion Database IDs (English)
NOTION_DB_EN=your-english-database-id

# ===========================================
# EMAIL NOTIFICATION (Required)
# ===========================================

# Resend API Key for email notifications
# Sign up at: https://resend.com (free tier: 3000 emails/month)
# Create API key at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Email recipient (already configured in workflow)
# Default: potensiainc@gmail.com

# ===========================================
# N8N SPECIFIC (Railway deployment)
# ===========================================

# n8n encryption key (generate a random 32-char string)
N8N_ENCRYPTION_KEY=your-32-character-encryption-key

# n8n basic auth (optional, for securing n8n UI)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your-secure-password

# Timezone
GENERIC_TIMEZONE=Asia/Seoul
