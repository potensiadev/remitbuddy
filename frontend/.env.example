# Environment Variables Example
# Copy this file to .env.local for local development

# Backend API URL
# For local development:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Notion blog CMS
NOTION_API_KEY=
BLOG_DATABASE_ID=

# Optional site URL for canonical/OG meta tags
# NEXT_PUBLIC_SITE_URL=https://www.remitbuddy.com