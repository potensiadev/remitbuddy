# Environment Variables Example
# Copy this file to .env.local for local development

# Backend API URL
# For local development:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Notion blog CMS
NOTION_API_KEY=
# Legacy single DB (optional fallback for both locales)
BLOG_DATABASE_ID=
# Recommended: separate DB per locale for manual bilingual publishing
BLOG_DATABASE_ID_KO=
BLOG_DATABASE_ID_EN=

# Optional site URL for canonical/OG meta tags
# NEXT_PUBLIC_SITE_URL=https://www.remitbuddy.com